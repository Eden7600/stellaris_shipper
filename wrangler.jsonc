// Cloudflare Workers config: an assets-only Worker serving the static Astro build.
// `npm run deploy` builds and deploys; with Workers Builds (Git integration) use
// build command `npm run build` and deploy command `npx wrangler deploy`.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stellaris-shipper",
  "compatibility_date": "2026-11-15",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
